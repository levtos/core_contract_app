    {"binding_id": "binding.fritz_cpu_unavailable", "source_id": "source.fritz_cpu_unavailable", "adapter": {"kind": "ha_state", "ha_entity_id": "sensor.fritz_box_7530_cpu_temperatur_2"}},
    {"binding_id": "binding.portal_cpu_unknown", "source_id": "source.portal_cpu_unknown", "adapter": {"kind": "ha_state", "ha_entity_id": "sensor.fritz_portal_cpu_temperatur"}},
